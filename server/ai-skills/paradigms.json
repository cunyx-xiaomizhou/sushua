{
  "_说明": "UI 组件范式库。两级: unit(单元类=由角色层组成) / container(容器类=铺 N 个某 unit)。AI 拿到人标好的'这框是什么组件'后,查此库;container 铺出多个 unit,每个 unit 再展开多层。位置全按 父框×范式比例 算,不 AI 目测。",
  "_字段说明": {
    "kind": "unit=由角色层组成 / container=铺 N 个某 unit",
    "unit.roles": "角色清单。role.id/name/type(image/button/text/panel)/required(false=可隐藏)/slot(通用角色枚举: bg铺满底/frame边框/icon居中主图/badge角标/mark状态覆盖/text文字/decoration装饰)/hiddenWhen(隐藏状态说明)/layout(w,h=占父框比例 0~1, anchor=对齐角)/resourceKeyHint(人读用)",
    "container.layout": "grid=网格 / hbox=横排 / vbox=竖排",
    "container.cell": "每个单元用哪个 unit 的 key",
    "container.columns/rows": "grid 的行列; hbox/vbox 用 count",
    "container.spacing": "单元间距 px"
  },
  "components": {
    "rewardCell": {
      "kind": "unit",
      "name": "奖励格",
      "desc": "领取类奖励的单个格子。底板+主体奖励图+数量必有;领取标记只在已领取时显示。",
      "roles": [
        {"id": "bg", "name": "底板", "type": "image", "required": true, "slot": "bg", "layout": {"w": 1.0, "h": 1.0, "anchor": "center"}, "resourceKeyHint": "奖励格底板"},
        {"id": "icon", "name": "奖励图", "type": "image", "required": true, "slot": "icon", "layout": {"w": 0.7, "h": 0.7, "anchor": "center"}, "resourceKeyHint": "奖励物品图"},
        {"id": "check", "name": "领取标记", "type": "image", "required": false, "slot": "mark", "hiddenWhen": "未领取时隐藏", "layout": {"w": 0.9, "h": 0.9, "anchor": "center"}, "resourceKeyHint": "已领取勾选"},
        {"id": "count", "name": "数量", "type": "text", "required": true, "slot": "text", "layout": {"w": 0.5, "h": 0.25, "anchor": "bottomRight"}}
      ]
    },
    "signCell": {
      "kind": "unit",
      "name": "签到格",
      "desc": "每日签到的单个格子。底板+奖励图标+天数必有;已签到标记只在已签到时显示。",
      "roles": [
        {"id": "bg", "name": "底板", "type": "image", "required": true, "slot": "bg", "layout": {"w": 1.0, "h": 1.0, "anchor": "center"}, "resourceKeyHint": "签到格底板"},
        {"id": "icon", "name": "奖励图标", "type": "image", "required": true, "slot": "icon", "layout": {"w": 0.6, "h": 0.6, "anchor": "top"}, "resourceKeyHint": "签到奖励图标"},
        {"id": "dayText", "name": "天数", "type": "text", "required": true, "slot": "text", "layout": {"w": 0.8, "h": 0.25, "anchor": "bottom"}},
        {"id": "signed", "name": "已签到标记", "type": "image", "required": false, "slot": "mark", "hiddenWhen": "未签到时隐藏", "layout": {"w": 0.6, "h": 0.6, "anchor": "center"}, "resourceKeyHint": "已签到标记"}
      ]
    },
    "itemSlot": {
      "kind": "unit",
      "name": "物品槽",
      "desc": "背包/商店物品格子。底板+物品图+品质框+数量角标。",
      "roles": [
        {"id": "bg", "name": "底板", "type": "image", "required": true, "slot": "bg", "layout": {"w": 1.0, "h": 1.0, "anchor": "center"}, "resourceKeyHint": "物品槽底板"},
        {"id": "icon", "name": "物品图", "type": "image", "required": true, "slot": "icon", "layout": {"w": 0.75, "h": 0.75, "anchor": "center"}, "resourceKeyHint": "物品图标"},
        {"id": "frame", "name": "品质框", "type": "image", "required": false, "slot": "frame", "layout": {"w": 1.0, "h": 1.0, "anchor": "center"}, "resourceKeyHint": "品质边框"},
        {"id": "count", "name": "数量", "type": "text", "required": false, "slot": "text", "layout": {"w": 0.4, "h": 0.2, "anchor": "bottomRight"}}
      ]
    },
    "tabButton": {
      "kind": "unit",
      "name": "页签按钮",
      "desc": "选项卡按钮。底板+图标+文字，选中/未选中两态。",
      "roles": [
        {"id": "bg", "name": "底板", "type": "image", "required": true, "slot": "bg", "layout": {"w": 1.0, "h": 1.0, "anchor": "center"}, "resourceKeyHint": "页签底板"},
        {"id": "icon", "name": "图标", "type": "image", "required": false, "slot": "icon", "layout": {"w": 0.5, "h": 0.5, "anchor": "top"}, "resourceKeyHint": "页签图标"},
        {"id": "label", "name": "标签文字", "type": "text", "required": true, "slot": "text", "layout": {"w": 0.9, "h": 0.3, "anchor": "bottom"}}
      ]
    },
    "navButton": {
      "kind": "unit",
      "name": "导航按钮",
      "desc": "底部导航栏按钮。图标+文字上下排列。",
      "roles": [
        {"id": "icon", "name": "图标", "type": "image", "required": true, "slot": "icon", "layout": {"w": 0.6, "h": 0.6, "anchor": "top"}, "resourceKeyHint": "导航图标"},
        {"id": "label", "name": "名称", "type": "text", "required": true, "slot": "text", "layout": {"w": 0.9, "h": 0.3, "anchor": "bottom"}}
      ]
    },
    "rewardGrid": {
      "kind": "container",
      "name": "奖励网格",
      "desc": "铺多个奖励格的网格容器。",
      "cell": "rewardCell",
      "layout": "grid",
      "columns": 5,
      "rows": 4,
      "spacing": 8
    },
    "signGrid": {
      "kind": "container",
      "name": "签到网格",
      "desc": "铺多个签到格的网格容器。",
      "cell": "signCell",
      "layout": "grid",
      "columns": 7,
      "rows": 4,
      "spacing": 8
    },
    "itemGrid": {
      "kind": "container",
      "name": "物品网格",
      "desc": "铺多个物品槽的网格容器。",
      "cell": "itemSlot",
      "layout": "grid",
      "columns": 5,
      "rows": 4,
      "spacing": 10
    },
    "tabBar": {
      "kind": "container",
      "name": "页签栏",
      "desc": "水平排列的页签按钮组。",
      "cell": "tabButton",
      "layout": "hbox",
      "spacing": 4
    },
    "bottomNav": {
      "kind": "container",
      "name": "底部导航栏",
      "desc": "底部导航按钮组。",
      "cell": "navButton",
      "layout": "hbox",
      "spacing": 0
    }
  }
}
